# ==============================================================================
# ModelWatch Environment Configuration Template
# Copy this file to .env and customize the values for your environment.
# ==============================================================================

# Server Network Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Cross-Origin Resource Sharing (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Automated Alert Notifications via Gmail SMTP
# (Generate a 16-character App Password from Google Account > Security > App Passwords)
GMAIL_SENDER_EMAIL=your_alerts_sender@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
ALERT_RECEIVER_EMAIL=your_alert_receiver@gmail.com

# Disable SMTP network calls in offline/sandbox/testing mode (1 = disabled, 0 = enabled)
DISABLE_EMAIL_ALERT=1
